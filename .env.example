# --- LLM ---
# anthropic | gemini | groq (boşsa anahtarı olan seçilir). Güvenlik sağlayıcıdan bağımsızdır.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Google AI Studio anahtarı (ücretsiz katman)
GEMINI_API_KEY=
# İsteğe bağlı model geçersiz kılma
GEMINI_MODEL=gemini-flash-latest
GEMINI_QUARANTINE_MODEL=gemini-flash-lite-latest
# Groq anahtarı (console.groq.com). LLM_PROVIDER=groq ile kullanılır.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QUARANTINE_MODEL=openai/gpt-oss-20b

# --- OKX Agent Trade Kit ---
# OKX anahtarları İKİ yoldan biriyle verilir:
#  (a) ~/.okx/config.toml (`npx okx config init`), veya
#  (b) aşağıdaki üç değişken (ATK sürecine sadece bunlar geçer). Demo Trading anahtarı, Read + Trade, Withdraw kapalı.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Guardian ATK'yı her zaman --demo ile başlatır.
OKX_PROFILE=demo
# global | eea | us | tr
OKX_SITE=global

# --- Avalanche Fuji ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Kontrat sahibi (kill-switch + policy hash). Sadece deploy/set-policy-hash betikleri kullanır, guardian kullanmaz.
DEPLOYER_PRIVATE_KEY=
# Sadece anchor tx'leri için, içinde sadece gas parası olan AYRI cüzdan
ANCHOR_PRIVATE_KEY=
POLICY_REGISTRY_ADDRESS=
# Her emirden önce niyet hash'inin yazıldığı kontrat (policy.intentCommit=true ise zorunlu; committer = ANCHOR cüzdanı)
INTENT_GATE_ADDRESS=
AUDIT_ANCHOR_ADDRESS=

# --- Guardian ---
# 32+ byte rastgele hex: openssl rand -hex 32
VAULT_HMAC_KEY=
# Arayüz ve onay uçları için yerel token: openssl rand -hex 16
UI_TOKEN=
GUARDIAN_PORT=7070
# Arayüz başka origin'den sunuluyorsa (Vercel) izinli origin'ler, virgülle; * bir ad parçası: https://avax-*-ekip.vercel.app
UI_ORIGINS=
ATTACK_SITE_PORT=7071
# read_url için izinli hostlar (virgülle)
# Virgülle host listesi; "*" = her herkese açık host (loopback/özel ağ hariç), docs/compat.md
READ_URL_ALLOWLIST=localhost,127.0.0.1
DB_PATH=data/guardian.db

# --- Kişisel hesaplar (docs/tenants.md) ---
# Supabase: boşsa web/.env.local'daki VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY kullanılır
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Kullanıcı OKX anahtarlarının şifreleme anahtarı (boşsa VAULT_HMAC_KEY'den türetilir): openssl rand -hex 32
TENANT_SECRET_KEY=
TENANTS_DIR=data/tenants
TENANT_MAX_RUNNING=20
TENANT_IDLE_MINUTES=30
# Başka cihazlardan erişim için (tünel tercih edilir): 0.0.0.0
GUARDIAN_HOST=127.0.0.1

# --- Servis kapısı (docs/service.md) ---
# Uzak MCP (/mcp, API anahtarlı) + herkese açık kanıt paneli. 0 = kapalı. Dışa açmak için tünel veya PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=7072
PUBLIC_HOST=127.0.0.1
# Tünel açtıysanız (örn. https://xxx.trycloudflare.com): arayüzdeki MCP sayfası bağlanma adresini bundan üretir
PUBLIC_URL=
