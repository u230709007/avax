# --- LLM ---
# anthropic | gemini | groq (boşsa anahtarı olan seçilir). Güvenlik sağlayıcıdan bağımsızdır.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Google AI Studio anahtarı (ücretsiz katman)
GEMINI_API_KEY=
# İsteğe bağlı model geçersiz kılma
GEMINI_MODEL=gemini-flash-latest
GEMINI_QUARANTINE_MODEL=gemini-flash-lite-latest
# Groq anahtarı (console.groq.com). LLM_PROVIDER=groq ile kullanılır.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_QUARANTINE_MODEL=llama-3.1-8b-instant

# --- OKX Agent Trade Kit ---
# OKX anahtarları İKİ yoldan biriyle verilir:
#  (a) ~/.okx/config.toml (`npx okx config init`), veya
#  (b) aşağıdaki üç değişken (ATK sürecine sadece bunlar geçer). Demo Trading anahtarı, Read + Trade, Withdraw kapalı.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Guardian ATK'yı her zaman --demo ile başlatır.
OKX_PROFILE=demo
# global | eea | us | tr
OKX_SITE=global

# --- Avalanche Fuji ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Kontrat sahibi (kill-switch + policy hash). Sadece deploy/set-policy-hash betikleri kullanır, guardian kullanmaz.
DEPLOYER_PRIVATE_KEY=
# Sadece anchor tx'leri için, içinde sadece gas parası olan AYRI cüzdan
ANCHOR_PRIVATE_KEY=
POLICY_REGISTRY_ADDRESS=
AUDIT_ANCHOR_ADDRESS=

# --- Guardian ---
# 32+ byte rastgele hex: openssl rand -hex 32
VAULT_HMAC_KEY=
# Arayüz ve onay uçları için yerel token: openssl rand -hex 16
UI_TOKEN=
GUARDIAN_PORT=7070
ATTACK_SITE_PORT=7071
# read_url için izinli hostlar (virgülle)
READ_URL_ALLOWLIST=localhost,127.0.0.1
DB_PATH=data/guardian.db
